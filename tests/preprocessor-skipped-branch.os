// Препроцессор: символ # внутри неактивной ветки #Если.
// Директивой считается только # первым непробельным символом строки.
// Модули собираются из строк, чтобы проверить оба окончания строк: CRLF и LF.
// Символ Клиент в OneScript не определён: "#Если Клиент" - неактивная ветка, "#Если Не Клиент" - активная.
// В шаблонах модулей ¶ - перевод строки.

Перем юТест;

Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

	юТест = ЮнитТестирование;
	ВсеТесты = Новый Массив;

	ВсеТесты.Добавить("ТестДолжен_ПропуститьРешеткуВСтрокеНеактивнойВетки");
	ВсеТесты.Добавить("ТестДолжен_ПропуститьИменаДирективВСтроках");
	ВсеТесты.Добавить("ТестДолжен_ПропуститьРешеткуВМногострочнойСтроке");
	ВсеТесты.Добавить("ТестДолжен_ПропуститьРешеткуВКомментариях");
	ВсеТесты.Добавить("ТестДолжен_НайтиДирективуСОтступом");
	ВсеТесты.Добавить("ТестДолжен_ПропуститьРешеткуВоВложенныхБлоках");
	ВсеТесты.Добавить("ТестДолжен_ПропуститьВетвиПослеВыполненногоУсловия");
	ВсеТесты.Добавить("ТестДолжен_НайтиДирективуПослеСтрокиКонецОбласти");
	ВсеТесты.Добавить("ТестДолжен_ОшибкаБезКонецЕслиПриДирективеВКомментарии");
	ВсеТесты.Добавить("ТестДолжен_ОшибкаБезКонецЕслиПриДирективеВСтроке");
	ВсеТесты.Добавить("ТестДолжен_ОшибкаБезКонецЕслиПриДирективеПослеКода");
	ВсеТесты.Добавить("ТестДолжен_ОшибкаНаНедопустимойДирективеВНачалеСтроки");
	ВсеТесты.Добавить("ТестДолжен_ОшибкаНаДирективеНеСНачалаСтрокиВАктивнойВетке");
	ВсеТесты.Добавить("ТестДолжен_ОшибкаСинтаксисаВАктивнойВетке");

	Возврат ВсеТесты;

КонецФункции

Функция ТестДолжен_ПропуститьРешеткуВСтрокеНеактивнойВетки() Экспорт

	ПроверитьКомпилируется("#Если Клиент Тогда¶А = ""цвет #000000"";¶#КонецЕсли¶Л = 1;");

КонецФункции

Функция ТестДолжен_ПропуститьИменаДирективВСтроках() Экспорт

	ПроверитьКомпилируется("#Если Клиент Тогда¶"
		+ "А = ""#КонецЕсли"";¶"
		+ "Б = ""#Иначе"";¶"
		+ "В = ""#ИначеЕсли Клиент Тогда"";¶"
		+ "Г = ""#Если Клиент Тогда"";¶"
		+ "Д = ""текст """"#КонецЕсли"""" в кавычках"";¶"
		+ "#Иначе¶"
		+ "Л = 1;¶"
		+ "#КонецЕсли");

КонецФункции

Функция ТестДолжен_ПропуститьРешеткуВМногострочнойСтроке() Экспорт

	ПроверитьКомпилируется("#Если Клиент Тогда¶"
		+ "А = ""первая строка¶"
		+ "|#КонецЕсли¶"
		+ Символы.Таб + "|#Иначе¶"
		+ "|цвет #000000"";¶"
		+ "#КонецЕсли");

КонецФункции

Функция ТестДолжен_ПропуститьРешеткуВКомментариях() Экспорт

	ПроверитьКомпилируется("#Если Клиент Тогда¶"
		+ "// #КонецЕсли¶"
		+ "А = 1; // #Иначе¶"
		+ Символы.Таб + "// #000000¶"
		+ "#КонецЕсли");

КонецФункции

Функция ТестДолжен_НайтиДирективуСОтступом() Экспорт

	ПроверитьКомпилируется("#Если Клиент Тогда¶"
		+ "А = ""#000000"";¶"
		+ " " + Символы.Таб + " #Иначе¶"
		+ "Л = 1;¶"
		+ Символы.Таб + "#КонецЕсли");

КонецФункции

Функция ТестДолжен_ПропуститьРешеткуВоВложенныхБлоках() Экспорт

	Т = Символы.Таб;
	ПроверитьКомпилируется("#Если Клиент Тогда¶"
		+ Т + "#Если Сервер Тогда¶"
		+ Т + Т + "А = ""#КонецЕсли"";¶"
		+ Т + "#ИначеЕсли ВебКлиент Тогда¶"
		+ Т + Т + "Б = ""#Иначе"";¶"
		+ Т + "#Иначе¶"
		+ Т + Т + "В = ""#000000"";¶"
		+ Т + "#КонецЕсли¶"
		+ Т + "Г = ""#КонецЕсли"";¶"
		+ "#ИначеЕсли ТолстыйКлиент Тогда¶"
		+ Т + "Д = ""#Иначе"";¶"
		+ "#Иначе¶"
		+ "Л = 1;¶"
		+ "#КонецЕсли");

КонецФункции

Функция ТестДолжен_ПропуститьВетвиПослеВыполненногоУсловия() Экспорт

	ПроверитьКомпилируется("#Если Не Клиент Тогда¶"
		+ "Л = 1;¶"
		+ "#ИначеЕсли Клиент Тогда¶"
		+ "А = ""#КонецЕсли"";¶"
		+ "#Иначе¶"
		+ "Б = ""#000000"";¶"
		+ "#КонецЕсли");

КонецФункции

Функция ТестДолжен_НайтиДирективуПослеСтрокиКонецОбласти() Экспорт

	// В 2.2.0 с LF настоящий #КонецЕсли сразу после строки #КонецОбласти отвергался
	ПроверитьКомпилируется("#Если Клиент Тогда¶#Область Область1¶А = 1;¶#КонецОбласти¶#КонецЕсли¶Л = 1;");

КонецФункции

Функция ТестДолжен_ОшибкаБезКонецЕслиПриДирективеВКомментарии() Экспорт

	ПроверитьНеКомпилируется("#Если Клиент Тогда¶// #КонецЕсли");

КонецФункции

Функция ТестДолжен_ОшибкаБезКонецЕслиПриДирективеВСтроке() Экспорт

	ПроверитьНеКомпилируется("#Если Клиент Тогда¶А = ""#КонецЕсли"";");

КонецФункции

Функция ТестДолжен_ОшибкаБезКонецЕслиПриДирективеПослеКода() Экспорт

	ПроверитьНеКомпилируется("#Если Клиент Тогда¶А = 1; #КонецЕсли");

КонецФункции

Функция ТестДолжен_ОшибкаНаНедопустимойДирективеВНачалеСтроки() Экспорт

	ПроверитьНеКомпилируется("#Если Клиент Тогда¶" + Символы.Таб + "#000000¶#КонецЕсли");

КонецФункции

Функция ТестДолжен_ОшибкаНаДирективеНеСНачалаСтрокиВАктивнойВетке() Экспорт

	ПроверитьНеКомпилируется("#Если Не Клиент Тогда¶А = ""#000000""; #КонецЕсли");

КонецФункции

Функция ТестДолжен_ОшибкаСинтаксисаВАктивнойВетке() Экспорт

	ПроверитьНеКомпилируется("#Если Не Клиент Тогда¶А = ""#000000"";¶Б = ;¶#КонецЕсли");

КонецФункции

Процедура ПроверитьКомпилируется(Шаблон)

	Для Каждого Окончание Из ОкончанияСтрок() Цикл
		Ошибка = ОшибкаКомпиляции(СтрЗаменить(Шаблон, "¶", Окончание.Значение));
		юТест.ПроверитьРавенство(Ошибка, Неопределено,
			Окончание.Ключ + ": модуль должен компилироваться, ошибка: " + Строка(Ошибка));
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНеКомпилируется(Шаблон)

	Для Каждого Окончание Из ОкончанияСтрок() Цикл
		Ошибка = ОшибкаКомпиляции(СтрЗаменить(Шаблон, "¶", Окончание.Значение));
		юТест.ПроверитьНеРавенство(Ошибка, Неопределено,
			Окончание.Ключ + ": модуль не должен компилироваться");
	КонецЦикла;

КонецПроцедуры

Функция ОкончанияСтрок()

	Окончания = Новый Структура;
	Окончания.Вставить("CRLF", Символы.ВК + Символы.ПС);
	Окончания.Вставить("LF", Символы.ПС);
	Возврат Окончания;

КонецФункции

Функция ОшибкаКомпиляции(Текст)

	Попытка
		ЗагрузитьСценарийИзСтроки(Текст);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции
